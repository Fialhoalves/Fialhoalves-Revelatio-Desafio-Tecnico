# Copie para .env (desenvolvimento local sem Docker)
DATABASE_URL=postgresql+psycopg://taskmanager:taskmanager@localhost:5432/taskmanager
# Em produção use ENVIRONMENT=production: a API não sobe com SECRET_KEY fraca
ENVIRONMENT=development
# Gere uma chave forte em produção: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me-dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Origens do front separadas por vírgula (em produção: URL da Vercel)
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10

# Seed
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
DEMO_USER_EMAIL=user@example.com
DEMO_USER_PASSWORD=user12345
